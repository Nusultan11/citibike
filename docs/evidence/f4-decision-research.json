    "preprocessing_rules": {
      "anomalous_id": {
        "problem": "Non-canonical IDs (`Shop Morgan`, `5308.04_`, `5348.06_old`, `1234.56`) may be service or transitional stations, not public docks",
        "rule": "ID outside ^dddd.d{1,2}$ and ^[A-Z]{2}ddd$, or equal to 1234.56, is excluded from training under preprocess=true; always retained in evaluation and flagged. `6242.1` (lost trailing zero) and `JC032` stay canonical",
        "test": "test_preprocessing_flags_and_train_only_filter"
      },
      "suspect_closure": {
        "problem": "A 7-day label bracket can label a closed station as true zeros",
        "rule": "Observed zero run of >=24h with same-month station rate*hours>=13.8155 (Poisson P<=1e-6) is excluded from training under preprocess=true; retained in evaluation and flagged",
        "test": "test_preprocessing_flags_and_train_only_filter"
      },
      "peaks_retained": {
        "problem": "Extreme counts dominate squared loss and tail MAE",
        "rule": "No clipping or winsorising: DATA_CONTRACTS forbids removing peaks",
        "test": "test_preprocessing_retains_extreme_values"
      },
      "missing_retained": {
        "problem": "Missing history can masquerade as zero demand",
        "rule": "NULL stays NULL in features; imputation only inside Poisson pipeline",
        "test": "test_missing_history_never_becomes_zero"
      }
    },
