    "stopping": "Fixed trial list; no adaptive extension. Exhausted cumulative budget records remaining trials as not_run and yields partial. Each fit, inference, wall and RSS budget failure is retained as a failed trial",
    "selection_rule": "Stage selections use macro MAE on tuning folds only. Feature set per algorithm: mean of both targets; within 0.25% of the best the fewest columns wins, then lexical. Preprocess: adopted only if it improves by >0.25%. Parameters per target: lowest macro MAE; the bounded configuration is kept unless beaten by >0.25%. Any failed fold excludes the variant. No second search round",
    "tie_tolerance": 0.0025,
    "decision_rule": "Per target, on the four holdout folds only: a variant is a research candidate if in cohort64 AND cohort128 it wins the majority of folds against Seasonal Naive, has no >20% key-segment degradation (n>=100, including peak_hour and stations 6753.08, 6230.02), valid resources and no warnings, and its family-wise paired macro MAE interval against Seasonal Naive is below zero; lowest cohort64 macro MAE among those, lexical tie; otherwise seasonal_naive. cohort256 is a sensitivity report and cannot create a candidate",
    "critical_extra": [
      "peak_hour",
      "station:6753.08",
      "station:6230.02"
    ],
    "primary_metric": "macro MAE over the same folds per target and population",
    "hypotheses": {
      "H1_cyclic": {
        "claim": "Bounded annual harmonics C cannot run off the training range",
        "expect": "LightGBM+C is not worse than LightGBM+A on the Dec fold; C gives no material gain over base on holdout",
        "check": "S1 fold T2 delta, S4 holdout ablation"
      },
      "H2_profile": {
        "claim": "Variability and shape P describe low/high demand stations",
        "expect": "P lowers MAE on history:thin and band:0, not necessarily overall",
        "check": "paired P vs base inside the segments, S4 ablation"
      },
      "H3_shrinkage": {
        "claim": "Pooling S protects stations with few cell labels",
        "expect": "S lowers activity:new and history:thin MAE against base",
        "check": "S4 ablation and segment deltas"
      },
      "H4_season_level": {
        "claim": "Year-ago seasonality carries the level that delayed labels lose",
        "expect": "Once season_index exists (holdout folds), bias magnitude falls",
        "check": "holdout fold bias, season_index missing share"
      },
      "H5_hurdle": {
        "claim": "Separate occurrence and intensity suit zero-heavy hours",
        "expect": "Hurdle beats single-stage LightGBM on activity:low and actual:zero, not on overall macro MAE",
        "check": "S3 paired hurdle vs lightgbm_selected"
      },
      "H6_preprocess": {
        "claim": "Training exclusions of suspect rows barely change fits",
        "expect": "Below 0.25% macro MAE change",
        "check": "S1 __pre variants on identical evaluation rows"
      },
      "H7_tuning": {
        "claim": "Bounded search is not the main lever",
        "expect": "Below 2% holdout macro MAE gain against the bounded configuration",
        "check": "S3 selected vs bounded configuration with the same features"
      },
      "H8_year_over_year": {
        "claim": "With the same calendar month in train, segment degradations shrink",
        "expect": "H2/H3 folds (Apr, Jul 2026) have fewer gate degradations than H0/H1",
        "check": "degraded segments per holdout fold"
      }
    },
