# Local API process; Compose overrides the bind host to 0.0.0.0 internally.
BIKEFLOW_API_HOST=127.0.0.1
BIKEFLOW_API_PORT=8000
BIKEFLOW_API_LOG_LEVEL=info
# Server-side Next.js setting. Compose uses http://api:8000 instead.
API_BASE_URL=http://127.0.0.1:8000
# Local Next.js port; also the published web port for Compose.
PORT=3000
# PostgreSQL serving. Generate a local secret; never commit it.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=bikeflow
PGUSER=bikeflow
PGPASSWORD=

# F7: export these variables in worker/server terminals (Prefect does not read
# this project's .env automatically). Metadata/artifacts stay local and ignored.
PREFECT_HOME=data/automation/prefect-home
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_SERVER_ANALYTICS_ENABLED=false
DO_NOT_TRACK=true
MLFLOW_DISABLE_TELEMETRY=true
BIKEFLOW_MLFLOW_PORT=5000
# Optional HTTPS webhook; leave empty to use durable structured alert events.
BIKEFLOW_ALERT_WEBHOOK=
